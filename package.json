{
  "name": "dsh-plugin-worktree-manager",
  "version": "0.1.0",
  "type": "module",
  "description": "Codex-style git worktree manager for DeepSeek Harness: a new-session start-mode picker (create worktree by default / current branch / existing), short per-session branch badges, and an agent-facing worktree tool. Profile-mounted static plugin.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "git",
    "worktree",
    "git-worktree"
  ],
  "license": "MIT",
  "author": "Fred Gu",
  "repository": {
    "type": "git",
    "url": "https://github.com/greatwhitesharklab/dsh-plugin-worktree-manager.git"
  },
  "homepage": "https://github.com/greatwhitesharklab/dsh-plugin-worktree-manager#readme",
  "bugs": {
    "url": "https://github.com/greatwhitesharklab/dsh-plugin-worktree-manager/issues"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.bundle.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "node --check src/index.js && node --check src/client.bundle.js"
  }
}
